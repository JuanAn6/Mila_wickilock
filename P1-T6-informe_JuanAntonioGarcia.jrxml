	<parameter name="Parameter1" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[$F{ID}]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select u.login as "propietari_login", u.email as "propietari_email", r.titol as "titol", r.descripcio as "ruta_descripcio" , 
r.desn_p as "desn_positiu", r.desn_n as "desn_negatiu", r.distancia as "distancia", r.temps as "temps", 
r.dificultat , r.id , p.num, p.ruta, p.nom, p.descripcio , p.lat, p.lon, p.alt
from rutes r  inner join usuaris u on u.login = r.propietari left join punts p on p.ruta = r.id 
where ($P{Parameter1} is null or p.ruta =   $P{Parameter1})
order by r.id asc, p.num asc]]>
	</queryString>
